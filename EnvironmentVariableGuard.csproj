<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	<PackageId>EnvironmentVariableGuard</PackageId>
	<Version>1.0.0</Version>
	<Authors>Leroy Gabriëlse</Authors>
	<Company>Utente</Company>
	<Description>Lightweight .NET helper to strictly validate environment variables at application startup.</Description>
	<PackageTags>environment;validation;configuration;guard</PackageTags>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="EnvironmentVariableGuard.Tests\**\*.cs" />
  </ItemGroup>

</Project>
